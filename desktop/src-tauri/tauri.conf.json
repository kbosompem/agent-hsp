{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent HSP",
  "version": "0.2.0",
  "identifier": "com.agenthsp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "console",
        "title": "Agent HSP · Console",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "output",
        "title": "Agent HSP · Output",
        "url": "output.html",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/backgrounds/**",
          "$APPDATA/media/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
